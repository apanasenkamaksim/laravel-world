{
    "name": "apanasenkamaksim/laravel-world",
    "description": "Provide countries, states, and cities relations database.",
    "keywords": [ "world", "country", "city", "region" ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "Khsing\\World\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Guixing Bai",
            "email": "khsing.cn@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Khsing\\World\\WorldServiceProvider"
            ]
        }
    }
}
